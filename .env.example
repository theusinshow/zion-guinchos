# Analytics — deixar vazio até existirem IDs reais (docs/OPEN-ITEMS.md P2).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Labels de conversão do Google Ads, um por evento. Vazio = o evento não dispara conversão.
# whatsapp_click
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=
# phone_click
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE=
# location_cta_click
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LOCATION=

# Domínio definitivo (canonical, Open Graph, sitemap). Vazio = noindex.
NEXT_PUBLIC_SITE_URL=

# Build de publicação. Defina 1 SOMENTE no ambiente Production, com todos os dados preenchidos.
# Com 1, o build falha se faltar telefone, WhatsApp, domínio, Política de Privacidade ou foto do Sobre.
ZION_RELEASE=
